# ── Target Group ─────────────────────────────────────────────────────────────
# The WhatsApp group where messages will be forwarded
# Format: 120363XXXXXXXXXX@g.us
# Run "node get-ids.js" to find this
TARGET_GROUP_ID=120363XXXXXXXXXX@g.us

# ── Source Channels ───────────────────────────────────────────────────────────
# Comma-separated WhatsApp Channel IDs to watch
# Format: XXXXXXXXXX@newsletter,YYYYYYYYYY@newsletter
# Run "node get-ids.js" to find these
# Leave EMPTY to forward from ALL channels you follow
SOURCE_CHANNEL_IDS=

# ── Optional: Keyword Filter ──────────────────────────────────────────────────
# Only forward messages containing these words (case-insensitive)
# Leave EMPTY to forward ALL messages
# Example: FILTER_KEYWORDS=breaking,sale,urgent
FILTER_KEYWORDS=
